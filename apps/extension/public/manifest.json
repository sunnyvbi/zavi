{
  "manifest_version": 3,
  "name": "Zavi",
  "version": "0.1.0",
  "key": "",
  "description": "Ask Zavi to do something in the tab you're on. It clicks and types for you, and asks before anything that clearly spends money.",
  "minimum_chrome_version": "125",
  "action": {
    "default_title": "Open Zavi",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "identity",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "https://api.zaviagent.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
