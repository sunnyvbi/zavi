  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android --dev-client",
    "ios": "expo start --ios --dev-client",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:dictation": "node --test tests/dictation.test.cjs",
    "test:creator": "node --test tests/creator-phase.test.cjs tests/creator-api.test.cjs tests/creator-copy.test.cjs",
    "lint": "expo lint",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:sim": "eas build --profile development-simulator --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:release:aab": "bash scripts/build-release-aab.sh",
    "build:preview": "eas build --profile preview --platform all",
    "build:prod:ios": "eas build --profile production --platform ios",
    "submit:ios": "eas submit --profile production --platform ios"
