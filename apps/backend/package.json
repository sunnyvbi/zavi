{
  "name": "@zavi/backend",
  "version": "0.2.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch -r tsconfig-paths/register server.ts",
    "build": "tsc -b ../../packages/shared && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=12288 tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fast": "vitest run --changed",
    "agent:run": "tsx -r tsconfig-paths/register scripts/run-agent.ts",
    "variants": "tsx -r tsconfig-paths/register scripts/variants-lab.ts",
    "probe:email-content": "tsx --env-file=.env -r tsconfig-paths/register scripts/email-content-probe.ts",
    "agent:smoke": "bash scripts/smoke-agent-runtime.sh",
    "test:cto": "tsx -r tsconfig-paths/register scripts/test-engineer-schemas.ts",
    "seed:upcar": "tsx -r tsconfig-paths/register scripts/seed-upcar-memory.ts",
    "test:rls": "tsx -r tsconfig-paths/register scripts/test-rls.ts",
    "test:feedback": "tsx -r tsconfig-paths/register scripts/test-feedback.ts",
    "test:staff-boundary": "tsx -r tsconfig-paths/register scripts/test-staff-boundary.ts",
    "packs:compile": "tsx -r tsconfig-paths/register scripts/compile-packs.ts",
    "test:packs:b0": "tsx -r tsconfig-paths/register scripts/test-packs-b0.ts",
    "doctor": "tsx -r tsconfig-paths/register scripts/praxis-doctor.ts",
    "qa:list": "tsx -r tsconfig-paths/register scripts/qa-suite.ts",
    "evals:list": "tsx -r tsconfig-paths/register scripts/evals-run.ts",
    "evals:run": "tsx -r tsconfig-paths/register scripts/evals-run.ts",
    "evals:judge-cal": "tsx -r tsconfig-paths/register scripts/judge-cal.ts",
    "evals:repeat-ab": "tsx -r tsconfig-paths/register scripts/run-repeat-task-ab.ts",
    "eval:cgo": "tsx -r tsconfig-paths/register scripts/eval-cgo.ts",
    "eval:engineer-quality": "tsx -r tsconfig-paths/register scripts/run-engineer-quality-eval.ts",
    "eval:research-quality": "tsx -r tsconfig-paths/register scripts/run-research-quality-eval.ts",
    "eval:memory-needle": "tsx -r tsconfig-paths/register scripts/run-needle-canary.ts",
    "eval:curate-real-repo": "tsx -r tsconfig-paths/register scripts/curate-real-repo-eval-tasks.ts",
    "eval:opdb:load": "tsx -r tsconfig-paths/register scripts/load-operator-db-eval-fixtures.ts",
    "eval:opdb:tools": "vitest run src/services/evals/operator-db-analytics/__tests__/tool-layer.live.test.ts",
    "eval:opdb:agent": "EVAL_OPDB_AGENT=1 vitest run src/services/evals/operator-db-analytics/__tests__/agent-analytics.live.test.ts",
    "governance:live": "tsx -r tsconfig-paths/register scripts/governance-live-suite.ts",
    "cleanup-test-resources": "node --env-file=.env scripts/cleanup-test-resources.mjs",
    "studio": "langgraphjs dev --port 2024",
    "sync:codex-env": "tsx scripts/sync-codex-env.ts",
    "probe:codex-langchain": "node --env-file=.env --import tsx scripts/probe-codex-langchain.ts",
    "probe:deepagent": "node --env-file=.env --import tsx -r tsconfig-paths/register scripts/probe-deepagent-live.ts",
    "probe:deepagent-e2e": "node --env-file=.env --import tsx -r tsconfig-paths/register scripts/probe-deepagent-e2e.ts",
    "probe:deepagent-chat": "node --env-file=.env --import tsx -r tsconfig-paths/register scripts/probe-deepagent-chat.ts",
    "creators:upload": "node --env-file=.env --import tsx scripts/import-creators.ts --file ../../private-data/creators.csv",
    "creators:list": "node --env-file=.env --import tsx scripts/import-creators.ts --list",
    "creators:send": "node --env-file=.env --import tsx scripts/send-creator-invites.ts --acknowledge-no-geo"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.59",
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@anthropic-ai/sdk": "^0.93.0",
    "@aws-sdk/client-dynamodb": "^3.1045.0",
    "@aws-sdk/client-secrets-manager": "^3.1045.0",
    "@aws-sdk/lib-dynamodb": "^3.1045.0",
    "@langchain/anthropic": "^1.5.4",
    "@langchain/core": "^1.2.5",
    "@langchain/fireworks": "^0.2.6",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/agents": "^0.11.6",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@types/ws": "^8.18.1",
    "@zavi/shared": "*",
    "bcryptjs": "3.0.2",
    "botbuilder": "^4.23.1",
    "cors": "^2.8.5",
    "deepagents": "^1.12.2",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "e2b": "2.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "7.4",
    "fontkit": "^2.0.4",
    "gray-matter": "^4.0.3",
    "inngest": "^3.54.2",
    "jose": "^5.9.6",
    "langchain": "^1.5.5",
    "livekit-server-sdk": "^2.15.3",
    "mammoth": "1.7",
    "mixpanel": "^0.23.0",
    "mongodb": "^7.2.0",
    "mongodb-schema": "^12.7.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.3",
    "openai": "^6.38.0",
    "parse5": "^7.3.0",
    "pdf-parse": "1.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "playwright-core": "^1.59.1",
    "psl": "^1.15.0",
    "robots-parser": "^3.0.1",
    "sharp": "^0.34.5",
    "shell-quote": "^1.11.0",
    "stripe": "^17.7.0",
    "tree-sitter-wasms": "0.1.13",
    "typescript": "5.5.4",
    "web-tree-sitter": "0.25.10",
    "write-excel-file": "^4.1.1",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@langchain/langgraph-cli": "^1.4.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "20.14.10",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.284",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.284",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "0.3.284",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "0.3.284",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.284",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "0.3.284",
    "@rollup/rollup-darwin-arm64": "^4.60.3"
  }
}
