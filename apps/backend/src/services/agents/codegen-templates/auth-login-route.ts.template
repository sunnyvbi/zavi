// BLESSED TEMPLATE — app/api/login/route.ts (POST). Copy verbatim; uses lib/auth.ts.
// One generic failure message for unknown email AND wrong password; throttled per
// IP and per email BEFORE the database is touched. A valid invite is redeemed after
// the password checks out.
import { NextResponse } from "next/server";
import { query } from "@/lib/db";
import { createSession } from "@/lib/session";
import {
  LIMITS,
  LOGIN_PAGE,
  clientIp,
  forbidden,
  isCrossSiteRequest,
  landingAfterAuth,
  readCredentials,
  redirectWithError,
  redirectWithSession,
  tooManyAttempts,
  verifyPassword,
} from "@/lib/auth";

export async function POST(req: Request): Promise<NextResponse> {
  if (isCrossSiteRequest(req)) return forbidden();
  const { email, password, invite } = await readCredentials(req);
  const throttled = tooManyAttempts([
    { key: `login:ip:${clientIp(req)}`, limit: LIMITS.ip },
    { key: `login:email:${email}`, limit: LIMITS.email },
  ]);
  if (throttled) return redirectWithError(LOGIN_PAGE, "too_many", invite);
  if (!email || !password) return redirectWithError(LOGIN_PAGE, "invalid", invite);
  let id: number;
  let session: string;
  try {
    const found = await query<{ id: number; password_hash: string }>(
      "SELECT id, password_hash FROM users WHERE email = $1",
      [email],
    );
    const row = found.rows[0];
    const ok = await verifyPassword(password, row?.password_hash ?? null);
    if (!row || !ok) return redirectWithError(LOGIN_PAGE, "invalid", invite);
    id = row.id;
    session = createSession(id);
  } catch (e) {
    console.error("[login] failed", (e as { code?: string })?.code ?? "unknown");
    return redirectWithError(LOGIN_PAGE, "server", invite);
  }
  return redirectWithSession(await landingAfterAuth(invite, id), session);
}
