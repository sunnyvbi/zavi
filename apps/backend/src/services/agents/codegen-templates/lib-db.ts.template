// ─────────────────────────────────────────────────────────────────────────────
// BLESSED TEMPLATE — lib/db.ts  (Postgres client for a GENERATED app)
//
// This file is a CORRECT reference the product-builder configures, NOT reinvents.
// Copy it verbatim into the generated app at `lib/db.ts` and change ONLY the
// queries you add — never the connection/type-parser plumbing below.
//
// WHY THIS EXISTS (holes it closes — do NOT reintroduce):
//   • node-postgres returns BIGINT/BIGSERIAL (Postgres OID 20, int8) as JS STRINGS
//     by default → `user.id === "1"`. A downstream `typeof uid === "number"` check
//     then rejects every session → every protected route 307→/login. The int8
//     type-parser below makes ALL ids deserialize as NUMBERS, killing that class.
//   • DATABASE_URL is SERVER-ONLY. No NEXT_PUBLIC_ prefix, never logged, never sent
//     to the browser. Importing this from a client component is a bug.
//   • Managed Postgres (Neon/Render) ships a valid CA + `sslmode=require` in the URL,
//     so the connection string drives TLS. Do NOT disable cert verification.
//   • DEGRADE GRACEFULLY: if DATABASE_URL is unset the module must still IMPORT (so
//     `next build` — which runs before DATABASE_URL is injected — cannot crash). The
//     throw is deferred to first query, and callers guard with `hasDatabase()`.
// ─────────────────────────────────────────────────────────────────────────────
import "server-only";
import pg from "pg";

// int8 (OID 20) → number. Registered BEFORE any pool is created / query runs.
// App ids are far below 2^53 so Number() is exact and safe.
pg.types.setTypeParser(20, (v: string | null) => (v === null ? null : Number(v)));

let _pool: pg.Pool | null = null;

/** True when a DATABASE_URL is present — guard DB reads in pages so the build
 *  (and a no-data deploy) can render an empty/error state instead of crashing. */
export function hasDatabase(): boolean {
  return Boolean(process.env.DATABASE_URL);
}

/** Lazily create ONE shared pool. The connection string drives TLS — do not
 *  pass `ssl: { rejectUnauthorized: false }`. Throws only at call time (never at
 *  import) so `next build` cannot fail on a not-yet-injected DATABASE_URL. */
function pool(): pg.Pool {
  const url = process.env.DATABASE_URL;
  if (!url) {
    throw new Error("DATABASE_URL is not set — refusing to query without a database");
  }
  if (!_pool) {
    _pool = new pg.Pool({ connectionString: url });
  }
  return _pool;
}

/** Run a parameterized query. ALWAYS use `$1, $2, …` placeholders — never string
 *  interpolation (SQL injection). Call ONLY from server components / route
 *  handlers / server actions, never a client component. */
export async function query<T extends pg.QueryResultRow = pg.QueryResultRow>(
  text: string,
  params: unknown[] = [],
): Promise<pg.QueryResult<T>> {
  return pool().query<T>(text, params as never);
}

/** Run fn inside ONE transaction on ONE pooled client (BEGIN/COMMIT, ROLLBACK on
 *  throw). Use it when several writes must land together or not at all; issue
 *  every statement on the `client` it hands you, never via query(). */
export async function withTransaction<T>(fn: (client: pg.PoolClient) => Promise<T>): Promise<T> {
  const client = await pool().connect();
  try {
    await client.query("BEGIN");
    const out = await fn(client);
    await client.query("COMMIT");
    return out;
  } catch (e) {
    await client.query("ROLLBACK").catch(() => undefined);
    throw e;
  } finally {
    client.release();
  }
}
