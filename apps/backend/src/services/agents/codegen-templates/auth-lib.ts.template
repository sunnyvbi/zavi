import "server-only";
import { createHash, randomBytes } from "node:crypto";
import { cookies } from "next/headers";
import { notFound, redirect as goTo } from "next/navigation";
import { NextResponse } from "next/server";
import bcrypt from "bcryptjs";
import { query, withTransaction } from "@/lib/db";
import { createSession, readSession } from "@/lib/session";

export const AFTER_LOGIN = "/dashboard";
export const LOGIN_PAGE = "/login";
export const SIGNUP_PAGE = "/signup";
export const ADMIN_PAGE = "/admin";

const COOKIE = "session";
// Max-Age mirrors lib/session.ts MAX_AGE_S (7 days); the signed exp is the real limit.
const COOKIE_ATTRS = "Path=/; HttpOnly; Secure; SameSite=Lax";
const MAX_AGE_S = 60 * 60 * 24 * 7;
export const BCRYPT_ROUNDS = 12;

/** 303 with a RELATIVE Location — the browser resolves it against the public origin. */
export function redirect(path: string): NextResponse {
  return new NextResponse(null, { status: 303, headers: { Location: path } });
}

const ERRORS = {
  too_many: "Too many attempts. Wait a few minutes and try again.",
  bad_input: "Enter a valid email and a password of at least 8 characters.",
  exists: "Couldn't create that account. If you already have one, sign in.",
  invalid: "Invalid email or password.",
  server: "Something went wrong. Try again.",
  invite: "This invite link has expired or was already used. Ask the site owner for a new one.",
  invite_email: "This invite link is for a different email address. Sign up or sign in with the email the invite was sent to.",
  magic: "This login link has expired or was already used. Ask the site owner for a new one.",
  session: "Sign-in isn't set up on this site yet, so we couldn't log you in. Your login link still works once that's fixed.",
} as const;
export type AuthError = keyof typeof ERRORS;

/** Fixed copy for a ?error= code; null for anything else (never echo the URL). */
export function authErrorMessage(code: string | undefined): string | null {
  return typeof code === "string" && Object.prototype.hasOwnProperty.call(ERRORS, code) ? ERRORS[code as AuthError] : null;
}

/** Keeps a well-formed invite on the redirect so a failed attempt can retry it. */
export function redirectWithError(page: string, code: AuthError, invite = ""): NextResponse {
  const q = new URLSearchParams({ error: code });
  if (isInviteToken(invite)) q.set("invite", invite);
  return redirect(`${page}?${q}`);
}

export function redirectWithSession(path: string, token: string): NextResponse {
  const res = redirect(path);
  res.headers.append("Set-Cookie", `${COOKIE}=${token}; ${COOKIE_ATTRS}; Max-Age=${MAX_AGE_S}`);
  return res;
}

export function redirectClearingSession(path: string): NextResponse {
  const res = redirect(path);
  res.headers.append("Set-Cookie", `${COOKIE}=; ${COOKIE_ATTRS}; Max-Age=0`);
  return res;
}

/** Email (trimmed, lowercased), password and optional invite from a form POST.
 *  Never throws. Any other field (e.g. a posted "role") is ignored. */
export async function readCredentials(req: Request): Promise<{ email: string; password: string; invite: string }> {
  try {
    const form = await req.formData();
    return {
      email: String(form.get("email") ?? "").trim().toLowerCase().slice(0, 254),
      password: String(form.get("password") ?? "").slice(0, 200),
      invite: String(form.get("invite") ?? "").slice(0, 200),
    };
  } catch {
    return { email: "", password: "", invite: "" };
  }
}

export function isValidEmail(email: string): boolean {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

/** Client IP for the per-IP throttle: the LAST X-Forwarded-For hop, the one the
 *  platform proxy appends. Earlier hops are client-set and spoofable. */
export function clientIp(req: Request): string {
  const hops = (req.headers.get("x-forwarded-for") ?? "").split(",").map((h) => h.trim()).filter(Boolean);
  return hops[hops.length - 1] || req.headers.get("x-real-ip")?.trim() || "unknown";
}

/** Login-CSRF guard: true when Sec-Fetch-Site says cross-site, or an Origin is sent
 *  whose host is not ours. No Origin and no Sec-Fetch-Site = allow (old clients). */
export function isCrossSiteRequest(req: Request): boolean {
  if (req.headers.get("sec-fetch-site") === "cross-site") return true;
  const origin = req.headers.get("origin");
  if (!origin) return false;
  const host = (req.headers.get("x-forwarded-host") ?? req.headers.get("host") ?? "").split(",")[0].trim();
  try {
    return new URL(origin).host !== host;
  } catch {
    return true; // "null" or malformed Origin
  }
}

export function forbidden(): NextResponse {
  return new NextResponse("Forbidden", { status: 403 });
}

// ── throttle: sliding window, bounded ────────────────────────────────────────
const WINDOW_MS = 15 * 60 * 1000;
export const LIMITS = { ip: 30, email: 10 } as const;
const MAX_KEYS = 10_000;
const attempts = new Map<string, number[]>();

/** Record one attempt under each key; true when ANY key is over its limit for the
 *  window. Call once per POST, before touching the database. */
export function tooManyAttempts(keys: Array<{ key: string; limit: number }>, now = Date.now()): boolean {
  let blocked = false;
  for (const { key, limit } of keys) {
    const recent = (attempts.get(key) ?? []).filter((t) => now - t < WINDOW_MS);
    recent.push(now);
    attempts.delete(key); // re-insert so the Map stays oldest-first
    attempts.set(key, recent);
    if (recent.length > limit) blocked = true;
  }
  while (attempts.size > MAX_KEYS) {
    const oldest = attempts.keys().next().value;
    if (oldest === undefined) break;
    attempts.delete(oldest);
  }
  return blocked;
}

// Compared against when the email is unknown, so a miss costs the same as a hit.
let dummyHash: string | null = null;
export async function verifyPassword(password: string, hash: string | null): Promise<boolean> {
  if (hash) return bcrypt.compare(password, hash);
  dummyHash ??= await bcrypt.hash("not-a-real-password", BCRYPT_ROUNDS);
  await bcrypt.compare(password, dummyHash);
  return false;
}

export type Role = "user" | "admin";
export type SiteUser = { id: number; email: string; role: Role };

/** The logged-in user, or null. Role is re-read from the DB on EVERY request, so a
 *  role change applies on the next request. Server components / route handlers only. */
export async function currentUser(): Promise<SiteUser | null> {
  const sess = readSession(cookies().get(COOKIE)?.value);
  if (!sess) return null;
  const r = await query<SiteUser>("SELECT id, email, role FROM users WHERE id = $1", [sess.uid]);
  return r.rows[0] ?? null;
}

/** Admin-only PAGE (server component): signed out -> /login; not admin -> 404
 *  (a Next 14 page cannot answer 403; a 404 also hides that the page exists). */
export async function requireAdminPage(): Promise<SiteUser> {
  const user = await currentUser();
  if (!user) goTo(LOGIN_PAGE);
  if (user.role !== "admin") notFound();
  return user;
}

/** Admin-only ROUTE HANDLER:
 *  `const { user, error } = await requireAdminRoute(); if (error) return error;` */
export async function requireAdminRoute(): Promise<
  { user: SiteUser; error: null } | { user: null; error: NextResponse }
> {
  const user = await currentUser();
  if (!user) return { user: null, error: new NextResponse("Unauthorized", { status: 401 }) };
  if (user.role !== "admin") return { user: null, error: forbidden() };
  return { user, error: null };
}

/** Admin-only SERVER ACTION: call first; throws unless the caller is an admin. */
export async function requireAdminAction(): Promise<SiteUser> {
  const user = await currentUser();
  if (user?.role !== "admin") throw new Error("Forbidden");
  return user;
}

// ── invites: the ONLY way a role is granted ─────────────────────────────────
// The site owner creates an invite in Zavi; only sha256(token) is stored. The token
// is never logged, rendered as text, or stored in plain form.
const INVITE_TOKEN = /^[A-Za-z0-9_-]{20,128}$/;
export function isInviteToken(t: string | undefined): t is string {
  return typeof t === "string" && INVITE_TOKEN.test(t);
}

/** Redeem an unused, unexpired, unrevoked invite for userId in ONE transaction.
 *  Returns the invite's role, or null (bad/used/expired/revoked). Never demotes. */
let inviteEmailColumn = false;

async function invitesHaveEmail(): Promise<boolean> {
  if (inviteEmailColumn) return true;
  const r = await query<{ has_email: boolean }>(
    "SELECT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = current_schema() AND table_name = 'invites' AND column_name = 'email') AS has_email",
  );
  inviteEmailColumn = r.rows[0]?.has_email === true;
  return inviteEmailColumn;
}

export async function redeemInvite(token: string, userId: number): Promise<Role | null> {
  if (!isInviteToken(token)) return null;
  const hash = createHash("sha256").update(token).digest("hex");
  const bound = await invitesHaveEmail();
  return withTransaction(async (c) => {
    const inv = await c.query<{ role: Role }>(
      bound
        ? "UPDATE invites SET used_at = now(), used_by = $2 WHERE token_hash = $1 AND used_at IS NULL AND revoked_at IS NULL AND expires_at > now() AND (email IS NULL OR lower(email) = (SELECT lower(email) FROM users WHERE id = $2)) RETURNING role"
        : "UPDATE invites SET used_at = now(), used_by = $2 WHERE token_hash = $1 AND used_at IS NULL AND revoked_at IS NULL AND expires_at > now() RETURNING role",
      [hash, userId],
    );
    const role = inv.rows[0]?.role;
    if (!role) return null;
    await c.query("UPDATE users SET role = $1 WHERE id = $2 AND role = 'user'", [role, userId]);
    await c.query(
      "INSERT INTO _zavi_audit (event, target_user_id, detail) VALUES ('invite_redeemed', $1, $2)",
      [userId, JSON.stringify({ role })],
    );
    return role;
  });
}

export async function inviteIsForAnotherEmail(token: string, userId: number): Promise<boolean> {
  if (!isInviteToken(token)) return false;
  if (!(await invitesHaveEmail())) return false;
  const hash = createHash("sha256").update(token).digest("hex");
  const r = await query<{ n: number }>(
    "SELECT 1 AS n FROM invites WHERE token_hash = $1 AND used_at IS NULL AND revoked_at IS NULL AND expires_at > now() AND email IS NOT NULL AND lower(email) <> (SELECT lower(email) FROM users WHERE id = $2)",
    [hash, userId],
  );
  return r.rows.length > 0;
}

export type MagicLogin = { ok: true; userId: number; session: string } | { ok: false; error: "magic" | "session" };

class SessionUnavailable extends Error {}

export async function magicLogin(token: string): Promise<MagicLogin> {
  if (!isInviteToken(token)) return { ok: false, error: "magic" };
  if (!(await invitesHaveEmail())) return { ok: false, error: "magic" };
  const hash = createHash("sha256").update(token).digest("hex");
  try {
    return await withTransaction<MagicLogin>(async (c) => {
      const inv = await c.query<{ id: number; role: Role; email: string }>(
        "UPDATE invites SET used_at = now() WHERE token_hash = $1 AND used_at IS NULL AND revoked_at IS NULL AND expires_at > now() AND email IS NOT NULL RETURNING id, role, email",
        [hash],
      );
      const row = inv.rows[0];
      if (!row) return { ok: false, error: "magic" };
      const email = row.email.trim().toLowerCase();
      const found = await c.query<{ id: number; role: Role }>("SELECT id, role FROM users WHERE lower(email) = $1", [email]);
      const existing = found.rows[0];
      let id = existing?.role === "admin" ? existing.id : undefined;
      if (existing && existing.role !== "admin") {
        await c.query("UPDATE users SET email = $2 WHERE id = $1", [existing.id, `displaced-${existing.id}-${randomBytes(12).toString("hex")}@invalid.invalid`]);
      }
      if (id === undefined) {
        const passwordHash = await bcrypt.hash(randomBytes(32).toString("base64url"), BCRYPT_ROUNDS);
        const inserted = await c.query<{ id: number }>(
          "INSERT INTO users (email, password_hash) VALUES ($1, $2) RETURNING id",
          [email, passwordHash],
        );
        id = inserted.rows[0].id;
      }
      await c.query("UPDATE invites SET used_by = $2 WHERE id = $1", [row.id, id]);
      await c.query("UPDATE users SET role = $1 WHERE id = $2 AND role = 'user'", [row.role, id]);
      await c.query(
        "INSERT INTO _zavi_audit (event, target_user_id, detail) VALUES ('magic_login', $1, $2)",
        [id, JSON.stringify({ role: row.role })],
      );
      let session: string;
      try {
        session = createSession(id);
      } catch {
        throw new SessionUnavailable();
      }
      return { ok: true, userId: id, session };
    });
  } catch (e) {
    if (e instanceof SessionUnavailable) return { ok: false, error: "session" };
    throw e;
  }
}

/** Where signup/login lands: AFTER_LOGIN, or AFTER_LOGIN?error=invite when an
 *  invite was sent but could not be redeemed. The account/session stands either
 *  way. Never throws. */
export async function landingAfterAuth(invite: string, userId: number): Promise<string> {
  if (!invite) return AFTER_LOGIN;
  try {
    if (await redeemInvite(invite, userId)) return AFTER_LOGIN;
    if (await inviteIsForAnotherEmail(invite, userId)) return `${AFTER_LOGIN}?error=invite_email`;
  } catch (e) {
    console.error("[invite] redeem failed", (e as { code?: string })?.code ?? "unknown");
  }
  return `${AFTER_LOGIN}?error=invite`;
}
