{
  "name": "zavi",
  "version": "0.2.0",
  "private": true,
  "scarfSettings": { "enabled": false },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @zavi/web",
    "dev:backend": "npm run dev -w @zavi/backend",
    "dev": "npm-run-all --parallel dev:backend dev:web",
    "build:web": "npm run build -w @zavi/web",
    "build:backend": "npm run build -w @zavi/backend",
    "build": "npm run build:backend && npm run build:web",
    "lint:web": "npm run lint -w @zavi/web",
    "agent:run": "npm run agent:run -w @zavi/backend --",
    "agent:smoke": "bash apps/backend/scripts/smoke-agent-runtime.sh",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "test:rls": "npm run test:rls -w @zavi/backend",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:env": "node apps/backend/scripts/check-local-env/check-local-env.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "next": "15.5.28",
    "patch-package": "^8.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "supabase": "^2.98.2",
    "typescript": "5.5.4",
    "e2b": "^2.20.1",
    "jsdom": "^24.1.3"
  },
  "overrides": {
    "zod": "4.4.3",
    "botbuilder": { "zod": "^3.23.8" },
    "botbuilder-core": { "zod": "^3.23.8" },
    "jose": "^5.9.6",
    "chalk": "^4.1.2",
    "next": "15.5.28",
    "react-is": "19.2.3",
    "shell-quote": "1.11.0",
    "dompurify": "3.4.17",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
