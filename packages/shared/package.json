{
  "name": "@zavi/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "development": "./src/types/*.ts",
      "default": "./dist/types/*.js"
    },
    "./db-guard": {
      "types": "./dist/db-guard/index.d.ts",
      "development": "./src/db-guard/index.ts",
      "default": "./dist/db-guard/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "typesVersions": {
    "*": {
      "db-guard": [
        "./dist/db-guard/index.d.ts"
      ]
    }
  }
}
